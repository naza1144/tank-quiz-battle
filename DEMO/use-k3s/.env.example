# ─────────────────────────────────────────────────
# Sudhood on k3s — secrets only
# ─────────────────────────────────────────────────
# คัดลอกเป็น .env แล้วเติมค่าจริง ทุกค่าที่เขียน CHANGE_ME ต้องเปลี่ยน
#
#   cp .env.example .env
#   openssl rand -base64 32        # สร้าง secret แบบสุ่ม
#   scripts/create-secrets.sh      # ยัดเข้า Kubernetes Secret
#
# ไฟล์นี้เก็บ "แค่ความลับ" ไม่ใช่ config ทั้งหมด — ต่างจาก .env ของฝั่ง
# docker compose ที่รวมทุกอย่างไว้ที่เดียว ค่าที่ไม่ใช่ความลับ (issuer, domain,
# token TTL, service URL) อยู่ใน k8s/config.yaml ซึ่ง commit ได้ปลอดภัย
#
# .env ถูก gitignore ไว้แล้ว — Secret ที่สร้างจากไฟล์นี้อยู่ในคลัสเตอร์เท่านั้น
# ─────────────────────────────────────────────────

# ── PostgreSQL ──
# ใช้ instance เดียว 2 database: sudhood (ข้อมูลแอป) + keycloak (ของ Keycloak เอง)
POSTGRES_PASSWORD=CHANGE_ME

# user/db ไม่ใช่ความลับ แต่ script ต้องใช้ประกอบ DATABASE_URL
# ⚠️ ต้องตรงกับ POSTGRES_USER / POSTGRES_DB ใน k8s/config.yaml
POSTGRES_USER=sudhood
POSTGRES_DB=sudhood

# รหัสของ login ต่อ service (m0_service / m1_service / m9_service) ซึ่งเป็นตัวที่
# service ใช้จริง — ไม่ใช่ superuser ข้างบน แต่ละตัวเห็นแค่ schema ของตัวเอง
# ปล่อยว่างไว้ = ใช้ POSTGRES_PASSWORD ทั้งคู่ (create-secrets.sh กับ
# postgres/init/02-service-users.sh fallback ไปที่เดียวกัน) เครื่อง dev ปล่อยว่างได้
# ถ้าตั้งค่าแล้วเปลี่ยนทีหลัง ต้องรัน 02-service-users.sh ใส่ pod เองรอบหนึ่ง
# เพราะ init script รันเฉพาะตอน data directory ว่าง
SERVICE_DB_PASSWORD=

# ── Redis (login state + refresh token) ──
REDIS_PASSWORD=CHANGE_ME

# ── MinIO (object storage · FN-X-020/021) ──
# root credential ใช้แค่ตอน bootstrap สร้าง bucket + key ของแต่ละ service
# ไม่มี service ไหนถือ root ตัวนี้ — m10 ถือ key ชื่อ m10_service เท่านั้น
MINIO_ROOT_USER=sudhood
MINIO_ROOT_PASSWORD=CHANGE_ME

# รหัสของ key ต่อ service (m0_service / m9_service / m10_service)
# ปล่อยว่าง = ใช้ MINIO_ROOT_PASSWORD เหมือน SERVICE_DB_PASSWORD ข้างบน
# ขอบเขตมาจาก policy ที่ผูกกับ key ไม่ได้มาจากรหัส — รหัสร่วมกันแค่ทำให้วงกว้างขึ้นตอนหลุด
MINIO_SERVICE_PASSWORD=

# ── Keycloak admin console ──
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── pgAdmin ──
PGADMIN_PASSWORD=CHANGE_ME

# ── Token Service → Keycloak (OIDC client secret) ──
# ค่านี้ยังไม่รู้ตอนติดตั้งครั้งแรก — ต้อง import realm ก่อน แล้วไปเอาจาก
# Keycloak Admin → realm sudhood → Clients → sudhood-token-service → Credentials
# แล้วรัน scripts/create-secrets.sh ซ้ำ (ดู SETUP-K3S.md ขั้นที่ 6)
OIDC_CLIENT_SECRET=CHANGE_ME

# ── Internal service-to-service ──
# token-service ใช้คีย์นี้เรียก M0 endpoint ภายในตอน resolve account
INTERNAL_API_KEY=CHANGE_ME
