@startuml
hide methods
hide stereotypes

skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam roundCorner 4
skinparam shadowing false
skinparam defaultFontName "Segoe UI, Tahoma, Helvetica, sans-serif"
skinparam defaultFontSize 11
skinparam defaultTextAlignment left
skinparam linetype ortho

' --- High-Clarity Enterprise Symmetrical Palette ---
skinparam ArrowColor #1B4F72
skinparam ArrowThickness 1.3
skinparam ArrowFontSize 9
skinparam ArrowFontColor #154360

skinparam package {
    BorderThickness 1.2
    BorderColor #7F8C8D
    FontColor #1A5276
    FontSize 12
    FontStyle boldaccount-service
    BackgroundColor #F8F9FA
}

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.1
    FontColor #1C2833
    FontSize 11
    HeaderBackgroundColor #EAEDED
}

title **ENTERPRISE 3NF NORMALIZED DATABASE ENTITY-RELATIONSHIP (ER) ARCHITECTURE**\n<size:10><color:#5D6D7E>Tank Quiz Battle 1990 — Dedicated Entities for Identity, Quiz Options, Difficulty & Tank Archetypes</color></size>\n

' ==============================================================================
' TOP TIER: ACADEMIC STRUCTURE & RBAC MASTER DATA
' ==============================================================================
package "1. Academic Master Hierarchy" as DomainAcademic {
    entity "FACULTY" as Faculty {
        * id : string <<PK>> (fac-eng)
        --
        * code : string (ENG)
        * name_th : string (คณะวิศวกรรมศาสตร์)
        name_en : string (Faculty of Engineering)
    }

    entity "DEPARTMENT" as Department {
        * id : string <<PK>> (dept-cpe)
        --
        * faculty_id : string <<FK>>
        * code : string (CPE)
        * name_th : string (วิศวกรรมคอมพิวเตอร์)
    }

    entity "SECTION" as Section {
        * id : string <<PK>> (sec-cpe-2026-1)
        --
        * department_id : string <<FK>>
        * section_code : string (Sec 1 / กลุ่ม 1)
        * academic_year : int (2569)
        * semester : int (1)
    }

    Faculty -down-> Department : "1:N"
    Department -down-> Section : "1:N"
}

package "2. RBAC & Identity Titles Master" as DomainRBAC {
    entity "ROLE" as Role {
        * id : string <<PK>> (STUDENT | TEACHER | ADMIN)
        --
        * name_th : string (บทบาทผู้ใช้งาน)
        description : string
    }

    entity "PERMISSION" as Permission {
        * id : string <<PK>> (game:play | quiz:write)
        --
        * module : string (GAME | QUIZ | ADMIN)
        description : string
    }

    entity "ROLE_PERMISSION_MAP" as RolePermissionMap {
        * role_id : string <<PK, FK>>
        * permission_id : string <<PK, FK>>
    }

    entity "TITLE" as Title {
        * id : string <<PK>> (tit-mr | tit-miss | tit-asst-prof-dr)
        --
        * title_th : string (นาย / นางสาว / ผศ.ดร.)
        title_en : string (Mr. / Miss / Asst. Prof. Dr.)
        abbr_th : string (นาย / น.ส. / ผศ.ดร.)
    }

    Role -right-> RolePermissionMap : "1:N"
    Permission -left-> RolePermissionMap : "1:N"
}

DomainAcademic -[hidden]right- DomainRBAC

' ==============================================================================
' MIDDLE-TOP TIER: USER ACCOUNT & DETACHED PERSONAL PROFILE (account-service)
' ==============================================================================
package "3. Account & Profile Domain (account-service:4005)" as DomainAccount {
    entity "USER_ACCOUNT" as UserAccount {
        * id : string <<PK>> (usr-6501001)
        --
        * email : string <<Unique Index>>
        google_sub : string (Google Subject ID)
        * role_id : string <<FK -> ROLE.id>>
        status : enum(ACTIVE, SUSPENDED)
        created_at : timestamp
        last_login_at : timestamp
    }

    entity "USER_PROFILE" as UserProfile {
        * id : string <<PK>> (prof-6501001)
        --
        * account_id : string <<FK -> USER_ACCOUNT.id, Unique>>
        title_id : string <<FK -> TITLE.id>>
        first_name_th : string (ชื่อจริงภาษาไทย)
        last_name_th : string (นามสกุลภาษาไทย)
        first_name_en : string (First Name)
        last_name_en : string (Last Name)
        display_name : string (ฉายาในเกม)
        avatar_url : string
    }

    entity "STUDENT_PROFILE" as StudentProfile {
        * student_id : string <<PK>> (6501001)
        --
        * user_profile_id : string <<FK -> USER_PROFILE.id>>
        * faculty_id : string <<FK -> FACULTY.id>>
        * department_id : string <<FK -> DEPARTMENT.id>>
        * section_id : string <<FK -> SECTION.id>>
        * enrollment_year : int (2565)
    }

    entity "TEACHER_PROFILE" as TeacherProfile {
        * teacher_id : string <<PK>> (T-801)
        --
        * user_profile_id : string <<FK -> USER_PROFILE.id>>
        * faculty_id : string <<FK -> FACULTY.id>>
        * department_id : string <<FK -> DEPARTMENT.id>>
        position_title : string (อาจารย์ประจำสาขา)
    }

    entity "TEACHER_SUBJECT_ASSIGNMENT" as TeacherSubject {
        * teacher_id : string <<PK, FK>>
        * category_id : string <<PK, FK>>
    }

    UserAccount -right-> UserProfile : "1:1 Personal Info"
    Title -down-> UserProfile : "1:N Title"
    UserProfile -down-> StudentProfile : "1:1 (if Student)"
    UserProfile -down-> TeacherProfile : "1:1 (if Teacher)"
    TeacherProfile -right-> TeacherSubject : "1:N Assigned"
}

Role -down-> UserAccount : "authorizes"
Section -down-> StudentProfile : "enrolled in"

' ==============================================================================
' MIDDLE-BOTTOM TIER: QUIZ & COMBAT MASTER ENTITIES
' ==============================================================================
package "4. Quiz Bank Domain (quiz-service:4001)" as DomainQuiz {
    entity "CATEGORY" as Category {
        * id : string <<PK>> (MATH | SCIENCE | ENGLISH)
        --
        name_th : string (ชื่อหมวดวิชา)
        question_count : int
    }

    entity "DIFFICULTY_LEVEL" as DifficultyLevel {
        * id : string <<PK>> (diff-easy | diff-med | diff-hard)
        --
        * code : enum(EASY, MEDIUM, HARD)
        * name_th : string (ง่าย / ปานกลาง / ยาก)
        * time_limit_seconds : int (2s, 5s, 7s)
        * reward_ammo : int (3, 4, 5)
        * bonus_points : int (100, 200, 300)
    }

    entity "QUIZ_QUESTION" as QuizQuestion {
        * id : string <<PK>> (math-1)
        --
        * category_id : string <<FK>>
        * difficulty_id : string <<FK -> DIFFICULTY_LEVEL.id>>
        provider_id : string <<FK>>
        question_th : text (โจทย์ภาษาไทย)
        question_en : text (English Question)
        explanation_th : text (คำอธิบายเฉลย)
        source : enum(LOCAL, EXTERNAL)
    }

    entity "QUIZ_OPTION" as QuizOption {
        * id : string <<PK>> (opt-math-1-a)
        --
        * question_id : string <<FK -> QUIZ_QUESTION.id>>
        * option_text_th : string (ข้อความตัวเลือก)
        option_text_en : string
        * is_correct : boolean (ตัวเลือกที่ถูก = true)
        * order_index : int (1..4)
    }

    entity "EXTERNAL_PROVIDER" as ExternalProvider {
        * id : string <<PK>> (Teacher_Somchai_LMS)
        --
        name : string (ระบบอาจารย์)
        api_key : string
        webhook_url : string
    }

    Category -down-> QuizQuestion : "1:N Questions"
    DifficultyLevel -right-> QuizQuestion : "1:N Rules"
    QuizQuestion -down-> QuizOption : "1:N Options"
    ExternalProvider -down-> QuizQuestion : "1:N Ingest"
    Category -up-> TeacherSubject : "subjects"
}

package "5. Realtime Combat Domain (game-server:4000)" as DomainCombat {
    entity "GAME_MODE" as GameMode {
        * id : string <<PK>> (mode-squad-6t | mode-ffa)
        --
        * code : enum(SQUAD_6T, FFA_SOLO)
        * name_th : string (6-Team Co-op / ประลองเดี่ยว)
        * max_teams : int (6)
        * players_per_team : int (1..4)
        * round_time_seconds : int (180s)
    }

    entity "TANK_ARCHETYPE" as TankArchetype {
        * id : string <<PK>> (arch-standard | arch-scout | arch-heavy | arch-sniper)
        --
        * name_th : string (Standard / Scout / Heavy / Sniper)
        * max_hp : int (3 / 2 / 5 / 2)
        * move_speed : float (1.0 / 1.5 / 0.8 / 1.1)
        * fire_cooldown_ms : int (500 / 350 / 800 / 900)
    }

    entity "SPECIAL_AMMO_TYPE" as SpecialAmmoType {
        * id : string <<PK>> (ammo-fire | ammo-ice | ammo-bounce | ammo-laser)
        --
        * name_th : string (กระสุนเพลิง / น้ำแข็ง / สะท้อน / ลำแสงเลเซอร์)
        * effect_type : enum(BURNING, FREEZING, RICOCHET, RAYMARCH)
        * damage_multiplier : float (1.5 / 1.0 / 1.0 / 3.0)
    }

    entity "ROOM" as Room {
        * id : string <<PK>> (room-alpha-1)
        --
        name : string
        * mode_id : string <<FK -> GAME_MODE.id>>
        * category_id : string <<FK>>
        section_id : string <<FK>>
        state : enum(LOBBY, IN_GAME, GAME_OVER)
    }

    entity "TEAM" as Team {
        * id : string <<PK>> (RED..CYAN)
        --
        * room_id : string <<FK>>
        color_hex : string
        total_score : int
        quiz_streak : int
        is_alive : boolean
    }

    entity "PLAYER_SESSION" as PlayerSession {
        * id : string <<PK>>
        --
        * room_id : string <<FK>>
        team_id : string <<FK>>
        account_id : string <<FK>>
        student_id : string <<FK>>
        * archetype_id : string <<FK -> TANK_ARCHETYPE.id>>
        role : enum(DRIVER, SUPPORT, GHOST)
        score : int
        kills : int
    }

    entity "TANK_STATE" as TankState {
        * id : string <<PK>>
        --
        * player_id : string <<FK>>
        * team_id : string <<FK>>
        * special_ammo_id : string <<FK -> SPECIAL_AMMO_TYPE.id>>
        x : float
        y : float
        hp : int
        ammo : int
        direction : enum(UP, DOWN, LEFT, RIGHT)
    }

    entity "QUIZ_VOTE_SESSION" as QuizVoteSession {
        * id : string <<PK>>
        --
        * team_id : string <<FK>>
        * question_id : string <<FK>>
        status : enum(VOTING, RESOLVED)
        majority_choice : int
        is_correct : boolean
    }

    GameMode -down-> Room : "1:N Rule"
    Room -down-> Team : "1:N (up to 6)"
    Room -down-> PlayerSession : "1:N Players"
    TankArchetype -right-> PlayerSession : "1:N Class"
    SpecialAmmoType -right-> TankState : "1:N Ammo"
    Team -right-> TankState : "1:1 Vehicle"
    Team -down-> QuizVoteSession : "1:N Votes"
    PlayerSession -down-> TankState : "drives"
}

DomainQuiz -[hidden]right- DomainCombat
Category -down-> Room : "selected subject"
UserAccount -down-> PlayerSession : "authorizes"

' ==============================================================================
' BOTTOM TIER: ANALYTICS & GRADE DISPATCH
' ==============================================================================
package "6. Analytics & Performance Domain" as DomainAnalytics {
    entity "STUDENT_SCORE_RECORD" as StudentScoreRecord {
        * id : string <<PK>>
        --
        * student_id : string <<FK>>
        * question_id : string <<FK>>
        room_id : string <<FK>>
        is_correct : boolean
        time_spent_seconds : float
        reported_to_lms : boolean
    }

    entity "MATCH_HISTORY" as MatchHistory {
        * id : string <<PK>>
        --
        * room_id : string <<FK>>
        winner_team_id : string <<FK>>
        team_rankings : json
        played_at : timestamp
    }

    StudentProfile -down-> StudentScoreRecord : "1:N Records"
    QuizQuestion -down-> StudentScoreRecord : "graded"
    Room -down-> MatchHistory : "1:1 Result"
}

@enduml
