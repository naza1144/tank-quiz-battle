# =================================================================
# TANK QUIZ BATTLE - ENVIRONMENT VARIABLES
# =================================================================

# ── Google OAuth 2.0 Credentials ────────────────────────────────
# รับค่าจาก Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URIs:
#   http://localhost:8080/realms/sudhood/broker/google/endpoint
#   https://localhost/realms/sudhood/broker/google/endpoint
GOOGLE_CLIENT_ID=YOUR_NEW_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_NEW_GOOGLE_CLIENT_SECRET_HERE

# ── Database & Cache ───────────────────────────────────────────
POSTGRES_USER=sudhood
POSTGRES_PASSWORD=sudhood_db_password
POSTGRES_DB=sudhood
REDIS_URL=redis://redis:6379/0

# ── Keycloak Identity Broker ───────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=dev-token-secret

# ── Token Service ──────────────────────────────────────────────
JWT_ISSUER=sudhood-token-service
JWT_AUDIENCE=sudhood-services
ALLOWED_EMAIL_DOMAIN=*
GAME_MODE=true

# ── Ports ──────────────────────────────────────────────────────
GAME_CLIENT_PORT=3000
GAME_SERVER_PORT=4000
KEYCLOAK_PORT=8080
GATEWAY_PORT=80
